<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Builds the mod for RimWorld 1.7, which runs on .NET 10 rather than Unity/Mono. The game maps
		UnityEngine.* references onto its UnityStubs.dll, so the mod compiles against that directly.
		The 1.6 build is the prebuilt 1.6/Assemblies/RimworldSkunks.dll; LoadFolders.xml picks one.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<RootNamespace>RimworldSkunks</RootNamespace>
		<AssemblyName>RimworldSkunks</AssemblyName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>1.7/Assemblies</OutputPath>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<!-- Reference paths come from the flake dev shell; the fallbacks are the standard Steam locations on macOS. -->
	<PropertyGroup>
		<RimWorldManaged Condition="'$(RIMWORLD_MANAGED)' != ''">$(RIMWORLD_MANAGED)</RimWorldManaged>
		<RimWorldManaged Condition="'$(RimWorldManaged)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorld.app/Contents/MacOS</RimWorldManaged>
		<HarmonyAssemblies Condition="'$(RIMWORLD_HARMONY)' != ''">$(RIMWORLD_HARMONY)</HarmonyAssemblies>
		<HarmonyAssemblies Condition="'$(HarmonyAssemblies)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies</HarmonyAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Source/**/*.cs" />
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldManaged)/UnityStubs.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- The engine behind the stubs: Material, Mesh and friends now live here. -->
		<Reference Include="Waylith">
			<HintPath>$(RimWorldManaged)/Waylith.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Waylith.UnityCompat">
			<HintPath>$(RimWorldManaged)/Waylith.UnityCompat.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- Compile against the Harmony mod's own 1.7 library; at runtime the Harmony mod provides it. -->
		<Reference Include="0Harmony">
			<HintPath>$(HarmonyAssemblies)/0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
